legacy-peer-deps=true
# min-release-age=7
# ignore-scripts=true

# ─── pnpm hoisting — required for Expo / Metro / Babel ───────────────────────
# Metro's transform workers spawn in threads that can't traverse pnpm's isolated
# store. shamefully-hoist flattens node_modules like npm/yarn so all packages
# are resolvable from the root — needed for the Expo ecosystem to work with pnpm.
shamefully-hoist=true
