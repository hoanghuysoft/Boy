{
  "expo": {
    "name": "WeLove",
    "slug": "Boy",
    "version": "2658.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "boy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.techfox.boy",
      "associatedDomains": [
        "applinks:boy-server.vercel.app"
      ],
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "vi",
          "zh-Hans",
          "zh-Hant"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#191919",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.techfox.boy",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "boy-server.vercel.app",
              "pathPrefix": "/posts"
            },
            {
              "scheme": "https",
              "host": "boy-server.vercel.app",
              "pathPrefix": "/post"
            },
            {
              "scheme": "http",
              "host": "boy-server.vercel.app",
              "pathPrefix": "/posts"
            },
            {
              "scheme": "http",
              "host": "boy-server.vercel.app",
              "pathPrefix": "/post"
            },
            {
              "scheme": "boy"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./withAndroidSvgFix",
      [
        "@bam.tech/react-native-app-security",
        {
          "preventRecentScreenshots": {
            "ios": {
              "enabled": true
            },
            "android": {
              "enabled": true
            }
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "android": {
            "image": "./assets/images/logo_head.png",
            "imageWidth": 180
          }
        }
      ],
      "@novastera-oss/rn-google-signin",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/GoogleSansRounded-Regular.ttf",
            "./assets/fonts/GoogleSansRounded-Bold.ttf",
            "./assets/fonts/GoogleSansRounded-Medium.ttf",
            "./assets/fonts/GoogleSansRounded-Thin.ttf",
            "./assets/fonts/GoogleSansRounded-Light.ttf",
            "./assets/fonts/GoogleSansRounded-ExtraLight.ttf",
            "./assets/fonts/tdesign/tdesign.ttf",
            "./assets/fonts/solar/solar.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "solar",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/solar/solar.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "tdesign",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/tdesign/tdesign.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "GoogleSansFlexRegular",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/GoogleSansRounded-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "GoogleSansFlexBold",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/GoogleSansRounded-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "GoogleSansFlexMedium",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/GoogleSansRounded-Medium.ttf",
                    "weight": 500
                  }
                ]
              },
              {
                "fontFamily": "GoogleSansFlexThin",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/GoogleSansRounded-Thin.ttf",
                    "weight": 100
                  }
                ]
              },
              {
                "fontFamily": "GoogleSansFlexLight",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/GoogleSansRounded-Light.ttf",
                    "weight": 300
                  }
                ]
              },
              {
                "fontFamily": "GoogleSansFlexExtraLight",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/GoogleSansRounded-ExtraLight.ttf",
                    "weight": 200
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usePrecompiledHeaders": true,
            "extraProguardRules": "-keep class androidx.media3.** { *; }\n-keep class expo.modules.video.** { *; }\n-keep class * extends com.margelo.nitro.core.HybridObject { *; }\n-keep class com.margelo.nitro.** { *; }\n-keep class com.nitroinappbrowser.** { *; }\n-keep class com.haptics.** { *; }"
          }
        }
      ],
      "expo-asset",
      "expo-web-browser",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "vi",
              "zh-Hans",
              "zh-Hant"
            ],
            "android": [
              "en",
              "vi",
              "zh-Hans",
              "zh-Hant"
            ]
          }
        }
      ],
      "expo-sharing",
      "expo-image",
      "react-native-nitro-wallpaper",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "techfox-ap"
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dac8585b-45f2-4ae7-a3b5-adfc3b76af46"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dac8585b-45f2-4ae7-a3b5-adfc3b76af46",
      "enableBsdiffPatchSupport": true
    }
  }
}