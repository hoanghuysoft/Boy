{
  "expo": {
    "name": "WeLove",
    "slug": "Boy",
    "version": "2026.4.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "boy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "vi"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.techfox.boy",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./withAndroidSvgFix",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "react-native-video",
        {
          "enableAndroidPictureInPicture": true
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-audio",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/GoogleSansRounded-Regular.ttf",
            "./assets/fonts/GoogleSansRounded-Bold.ttf",
            "./assets/fonts/GoogleSansRounded-Medium.ttf",
            "./assets/fonts/GoogleSansRounded-Thin.ttf",
            "./assets/fonts/GoogleSansRounded-Light.ttf",
            "./assets/fonts/GoogleSansRounded-ExtraLight.ttf",
            "./assets/fonts/FluentEmojiColor.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "GoogleSansFlexRegular",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/GoogleSansRounded-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "GoogleSansFlexBold",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/GoogleSansRounded-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "GoogleSansFlexMedium",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/GoogleSansRounded-Medium.ttf",
                    "weight": 500
                  }
                ]
              },
              {
                "fontFamily": "GoogleSansFlexThin",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/GoogleSansRounded-Thin.ttf",
                    "weight": 100
                  }
                ]
              },
              {
                "fontFamily": "GoogleSansFlexLight",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/GoogleSansRounded-Light.ttf",
                    "weight": 300
                  }
                ]
              },
              {
                "fontFamily": "GoogleSansFlexExtraLight",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/GoogleSansRounded-ExtraLight.ttf",
                    "weight": 200
                  }
                ]
              },
              {
                "fontFamily": "FluentEmoji",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/FluentEmojiColor.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-asset",
      "expo-web-browser",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "vi"
            ],
            "android": [
              "en",
              "vi"
            ]
          }
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "13168ed1-cd09-4dea-840b-86f37dbb087d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
