{
  "cli": {
    "version": ">= 20.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "image": "latest"
      },
      "android": {
        "buildType": "apk"
      },
      "node": "22.14.0",
      "bun": "1.4.2"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "image": "latest"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "production",
      "node": "22.14.0",
      "bun": "1.4.2"
    }
  },
  "submit": {
    "production": {}
  }
}